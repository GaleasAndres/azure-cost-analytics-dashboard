{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "polandcentral"
    },
    "environment": {
      "value": "dev"
    },
    "workload": {
        "value": "shared"
    },
    "resourcePrefix": {
        "value": "agapp"
    },
    "containerRegistryConfig": {
        "value": {
            "sku": "Basic",
            "adminUserEnabled": false,
            "publicNetworkAccess": "Enabled"
        }
    },
    "keyVaultConfig": {
        "value": {
            "sku": "standard"
        }
    },
    "monitoringConfig": {
        "value": {
            "logAnalytics": {
                "sku": "PerGB2018",
                "retentionInDays": 30
            },
            "appInsights": {
                "appType": "web"
            }
        }
    }
  }
}